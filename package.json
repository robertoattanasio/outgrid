{
  "name": "outgrid",
  "version": "0.1.0",
  "description": "A CSS layout grid with full-bleed breakouts and a global setup through custom properties. Plain CSS, with an optional Tailwind CSS v4 entry.",
  "keywords": [
    "css",
    "grid",
    "layout",
    "full-bleed",
    "breakout",
    "subgrid",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "Roberto Attanasio",
  "homepage": "https://dev.robertoattanasio.com/outgrid",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoattanasio/outgrid.git"
  },
  "bugs": {
    "url": "https://github.com/robertoattanasio/outgrid/issues"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "style": "./src/grid.css",
      "default": "./src/grid.css"
    },
    "./tailwind": {
      "style": "./src/tailwind.css",
      "default": "./src/tailwind.css"
    }
  },
  "scripts": {
    "changeset:add": "changeset",
    "changeset:bump": "changeset version",
    "build:release": "npm pack && changeset publish && git push --follow-tags"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
